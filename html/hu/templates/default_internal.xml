    <script src="https://cdn.jsdelivr.net/npm/@fancyapps/ui/dist/fancybox.umd.js" defer></script>
    <script defer>
document.addEventListener("DOMContentLoaded", function() {

    // 1. Keresd meg az összes dokumentum linket
    const docLinks = document.querySelectorAll('.ep_document_link');

    // 2. Hozz létre egy rejtett divet, ami a lightbox galériát fogja tartalmazni
    const galleryDiv = document.createElement('div');
    galleryDiv.style.display = 'none';
    document.body.appendChild(galleryDiv);

    // 3. Másold át az összes img linket a lightbox galériába
    docLinks.forEach((link, index) => {
        const img = link.querySelector('img');
        if(img) {
            const a = document.createElement('a');
            a.href = link.href; // a fájl maga
            a.setAttribute('data-fancybox', 'press-gallery'); // mind ugyanahhoz a galériához tartozik
            a.setAttribute('data-caption', img.alt || "Document " + (index+1));
            
            // thumbnail
            const thumb = document.createElement('img');
            thumb.src = img.src;
            thumb.style.display = 'none'; // ne látszódjon a thumb
            a.appendChild(thumb);

            galleryDiv.appendChild(a);
        }
    });

    // 4. Helyettesítsd az eredeti képeket kattinthatóvá
    docLinks.forEach(link => {
        const img = link.querySelector('img');
        if(img) {
            img.style.cursor = 'pointer';
            img.addEventListener('click', function(e) {
                e.preventDefault();
                Fancybox.show(
                    Array.from(galleryDiv.querySelectorAll('a')).map(a => ({
                        src: a.href,
                        type: 'image',
                        caption: a.getAttribute('data-caption')
                    })),
                    {
                        infinite: true,
                        Carousel: { 
                            friction: 0.97,
                            preload: 1
                        }
                    }
                );
            });
        }
    });

});
    </script>
