<meta name="eprints.title" content="Szemelvények a kisgyermeknevelés köréből II." />
<meta name="eprints.ispublished" content="pub" />
<meta name="eprints.subjects" content="AC" />
<meta name="eprints.subjects" content="LB1501" />
