<meta content="Agrár-biotechnológia és precíziós nemesítés az élelmiszer-biztonságért Nemzeti Laboratórium, Magyar Agrár- és Élettudományi Egyetem, Élettani és Takarmányozástani Intézet, Élettani és Állategészségügyi Tanszék, Kaposvár, 7400 Kaposvár, Guba Sándor utca 4" name="eprints.corp_creators" />
