<meta name="eprints.pages" content="43" />
<meta name="eprints.refereed" content="TRUE" />
<meta name="eprints.funders" content="TÁMOP-4.1.2.B.2-13/1-2013-0014" />
<meta name="eprints.projects" content="A TÁMOP-4.1.2.B.2-13/1-2013-0014 azonosító jelű, a „Pedagógusképzést segítő hálózatok továbbfejlesztése a Dél-Dunántúl régióban”" />
