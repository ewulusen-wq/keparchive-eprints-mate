<meta content="Talaj- és vízvédelmi kutatások a Koppányvölgyi Élőhely-rehabilitációs Kísérleti Területen" name="eprints.title" />
<meta content="pub" name="eprints.ispublished" />
<meta content="Q1" name="eprints.subjects" />
