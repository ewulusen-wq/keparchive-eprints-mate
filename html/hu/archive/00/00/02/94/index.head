<meta content="Disparities in Entrepreneurial Orientation and Openness to Innovation Among Budapest, the Pest Region, and Other Regions" name="eprints.title" />
<meta content="pub" name="eprints.ispublished" />
<meta content="HB" name="eprints.subjects" />
