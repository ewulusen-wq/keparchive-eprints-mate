<meta name="eprints.full_text_status" content="public" />
<meta name="eprints.publication" content="TÁJÖKOLÓGIAI LAPOK / JOURNAL OF LANDSCAPE ECOLOGY" />
<meta name="eprints.volume" content="7" />
<meta name="eprints.number" content="1" />
<meta name="eprints.pagerange" content="39-63" />
