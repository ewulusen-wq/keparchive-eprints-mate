<meta content="Differences between ex-situ and in situ germination and seedling establishment in the case of the marsh gladiolus (Gladiolus palustris)" name="eprints.title" />
<meta content="pub" name="eprints.ispublished" />
<meta content="S1" name="eprints.subjects" />
