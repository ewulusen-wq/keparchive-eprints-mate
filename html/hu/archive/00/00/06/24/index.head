<meta name="eprints.title" content="Mikotoxinok hatása a reprodukcióra – állat- és humán egészségügyi kockázatok" />
<meta name="eprints.ispublished" content="pub" />
<meta name="eprints.subjects" content="QP" />
<meta name="eprints.subjects" content="RA0421" />
<meta name="eprints.subjects" content="RG" />
