<meta name="DC.title" content="Mikotoxinok hatása a reprodukcióra – állat- és humán egészségügyi kockázatok" />
<meta name="DC.creator" content="Szőke, Zsuzsanna" />
<meta name="DC.creator" content="Molnár, Zsófia" />
