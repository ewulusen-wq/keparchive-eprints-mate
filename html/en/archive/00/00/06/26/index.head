<meta content="Probiotikus baktériumok jellemzése és felhasználása a mikotoxinok elleni védekezésben" name="eprints.title" />
<meta content="pub" name="eprints.ispublished" />
<meta content="QH301" name="eprints.subjects" />
<meta content="QR" name="eprints.subjects" />
