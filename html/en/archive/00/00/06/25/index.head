<meta name="eprints.title" content="Tejsavbaktériumokkal a fonalas gombák mikotoxinjai ellen" />
<meta name="eprints.ispublished" content="pub" />
<meta name="eprints.subjects" content="QH301" />
<meta name="eprints.subjects" content="QR" />
<meta name="eprints.subjects" content="RA0421" />
<meta name="eprints.subjects" content="S1" />
<meta name="eprints.subjects" content="TP" />
