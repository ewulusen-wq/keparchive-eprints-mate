<meta name="DC.title" content="Tejsavbaktériumokkal a fonalas gombák mikotoxinjai ellen" />
<meta name="DC.creator" content="Kovács, Szilvia" />
<meta name="DC.creator" content="Adácsi, Cintia" />
<meta name="DC.creator" content="Szarvas, Pál" />
<meta name="DC.creator" content="Király, Szabina" />
