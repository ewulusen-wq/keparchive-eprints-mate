<meta content="A Non-Invasive Method to Monitor the Smooth Muscle Activity of Digestive Organs in Growing Pigs" name="eprints.title" />
<meta content="pub" name="eprints.ispublished" />
<meta content="AC" name="eprints.subjects" />
