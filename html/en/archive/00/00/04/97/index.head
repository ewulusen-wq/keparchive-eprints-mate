<meta content="A Magyarországon előforduló meghatározó jelentőségű és gyakori talajtípusok fitolit profiljának katasztere IV. A vizsgált csernozjom és szikes talajok eredményei" name="eprints.title" />
<meta content="pub" name="eprints.ispublished" />
<meta content="S1" name="eprints.subjects" />
