<meta name="eprints.title" content="Outdoor fejlesztőmódszerek a pedagógus eszköztárában" />
<meta name="eprints.ispublished" content="pub" />
<meta name="eprints.subjects" content="LB1501" />
<meta name="eprints.subjects" content="LC" />
