<meta name="eprints.title" content="A vadászati célú etetőhelyek természetes élőhelyekre gyakorolt hatásainak vizsgálata eltérő táji környezetben" />
<meta name="eprints.ispublished" content="pub" />
<meta name="eprints.subjects" content="GE" />
<meta name="eprints.subjects" content="SK" />
