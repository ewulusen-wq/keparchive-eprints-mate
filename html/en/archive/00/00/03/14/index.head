<meta name="eprints.title" content="Tenyésztett és vad mezei nyulak viselkedésének elemzése" />
<meta name="eprints.ispublished" content="pub" />
<meta name="eprints.subjects" content="S1" />
<meta name="eprints.subjects" content="SF" />
<meta name="eprints.subjects" content="SK" />
