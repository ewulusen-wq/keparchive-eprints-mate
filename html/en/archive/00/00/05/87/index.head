<meta content="Pleisztocén-Holocén vegetáció a Fejér megyei Sárrét területén" name="eprints.title" />
<meta content="pub" name="eprints.ispublished" />
<meta content="Q1" name="eprints.subjects" />
<meta content="S1" name="eprints.subjects" />
