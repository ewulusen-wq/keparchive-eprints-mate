<meta content="Tájtervezési és Területfejlesztési Tanszék BCE / Táj.K TTFT [2003-2015]" name="eprints.corp_creators" />
<meta content="A tájtervezés és a tájvédelem helyzete az európai országok területi tervezésében" name="eprints.title" />
<meta content="pub" name="eprints.ispublished" />
