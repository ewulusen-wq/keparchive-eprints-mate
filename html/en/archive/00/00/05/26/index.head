<meta content="A Friedberger Ach vízrendszerének és a Sós-ér vízi vegetációjának kvantitatív felmérése" name="eprints.title" />
<meta content="pub" name="eprints.ispublished" />
<meta content="S1" name="eprints.subjects" />
