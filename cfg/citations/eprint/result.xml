<?xml version="1.0" ?>
<cite:citation xmlns="http://www.w3.org/1999/xhtml" xmlns:cite="http://eprints.org/ep3/citation" xmlns:epc="http://eprints.org/ep3/control">
  <div class="ep_search_result">
    <p>
      <epc:if test="is_set($item.key_value('creators'))">
        <epc:print expr="$item.render_value('creators')" />
      </epc:if>
      <epc:if test="is_set($item.key_value('date'))">
        (<epc:print expr="substr($item.key_value('date'), 0, 4)" />)
      </epc:if>
      <epc:print expr="$item.citation('default')" />.
      <epc:if test="is_set($item.key_value('publication'))">
        <em><epc:print expr="$item.key_value('publication')" /></em>,
      </epc:if>
      <epc:if test="is_set($item.key_value('volume'))">
        <epc:print expr="$item.key_value('volume')" />
      </epc:if>
      <epc:if test="is_set($item.key_value('number'))">
        (<epc:print expr="$item.key_value('number')" />)
      </epc:if>
      <epc:if test="is_set($item.key_value('pagerange'))">
        . pp. <epc:print expr="$item.key_value('pagerange')" />.
      </epc:if>
      <epc:if test="is_set($item.key_value('id_number'))">
        ISSN <epc:print expr="$item.key_value('id_number')" />
      </epc:if>
      <epc:set name="docs" expr="$item.documents()">
        <epc:if test="length($docs) > 0">
          <epc:foreach expr="$docs" iterator="doc">
            [thumbnail of <epc:print expr="$doc.render_value('type')" />]
          </epc:foreach>
        </epc:if>
      </epc:set>
    </p>
  </div>
</cite:citation>
