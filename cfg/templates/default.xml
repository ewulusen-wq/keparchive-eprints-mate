  <section>
    <div class="container" id="latest-additions">
        <header class="text-center">
            <h2 class="section-title">Latest Additions</h2>
            <div class="section-subtitle">New outputs added to the repository</div>
        </header>

        <script>// <![CDATA[

    var latest_additions;

    $(function(){

        latest_additions = $("#latest-additions");

        $.get('{$config{rel_cgipath}}/latest_tool', {n: 8, output: "RSS"}, function(data) {
            $(data).find("item").each(function() {
                $this = $(this);

                var description = $this.find("description").text();
                var link = $this.find("link").text();
                var linkParts = link.split("/");
                var id = linkParts[linkParts.length - 2] || "";
                var labelledBy = "";

                if ( id ) {
                    id = ` id="${id}"`;
                    labelledBy = ` aria-labelledby="${labelledBy}"`;
                }

                latest_additions.append(
                `<div class="row call-to-action  paper-block">
                    <div class="col-xl-1"><span class="icon icon-file-text-o" style="font-size: 64px; color: #ccd4dc;"></span>
                    </div>
                    <div class="col-xl-9">
                        <div ${id}>${description}</div>
                    </div>
                    <div class="col-xl-2"><a href="${link}" class="btn btn-primary btn-action mt-3" ${labelledBy}> Read More</a>
                    </div>
                </div>`
                );
            });
        });
    });

  // ]]>
</script>

